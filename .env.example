# All values have working defaults baked into docker-compose.yml.
# Copy to .env only if you want to override something.
POSTGRES_DB=supplyiq
POSTGRES_USER=supplyiq
POSTGRES_PASSWORD=supplyiq_local_password
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
NODE_ENV=development
# Set to false to skip the first-run seed + model training step.
BACKEND_AUTO_BOOTSTRAP=true
